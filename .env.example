# Copia este archivo como .env y rellena los valores
# NUNCA subas .env a GitHub

# Base de datos — elige una contraseña segura
POSTGRES_PASSWORD=elige_una_password_segura
DATABASE_URL=postgresql://agrovision:elige_una_password_segura@db:5432/agrovision

# Modo de datos: "mock" para desarrollo sin GEE, "gee" para datos reales
DATA_MODE=mock

# Google Earth Engine (solo necesario si DATA_MODE=gee)
GEE_PROJECT=tu-project-id-aqui
GEE_CREDENTIALS_JSON=
GEE_REFRESH_TOKEN=
