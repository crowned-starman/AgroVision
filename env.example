# Copia este archivo como .env y rellena los valores
# NUNCA subas .env a GitHub

# Base de datos
POSTGRES_PASSWORD=cambia_esta_password_por_una_segura
DATABASE_URL=postgresql://agrovision:cambia_esta_password_por_una_segura@db:5432/agrovision

# Google Earth Engine
GEE_PROJECT=tu-project-id-aqui

# Modo de datos: "mock" para desarrollo, "gee" para producción
DATA_MODE=mock

# API Key — genera una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
API_KEY=cambia_esto_por_una_clave_segura_generada_con_el_comando_de_arriba

# Frontend (Vite) — debe coincidir con API_KEY del backend
VITE_API_KEY=cambia_esto_por_la_misma_clave_que_API_KEY
